{
    "require": {
        "vlucas/phpdotenv": "^5.6",
        "westacks/telebot": "^3.4",
        "openai-php/client": "^0.10.3",
        "guzzlehttp/guzzle": "^7.9",
        "morilog/jalali": "3.*"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "src/Core/",
            "Infrastructure\\": "src/Infrastructure/",
            "Presentation\\": "src/Presentation/",
            "Bootstrap\\": "src/Bootstrap"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
